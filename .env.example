# Firefly III API Configuration
FIREFLY_III_URL=https://your-firefly-iii-instance.com
FIREFLY_III_TOKEN=your-personal-access-token

# LLM Provider Configuration
# Set to "9router" (or "openai") to route through 9router, or "gemini" for direct Google AI.
# If ROUTER_BASE_URL is set, "9router" is automatically selected.
LLM_PROVIDER=auto

# 9Router / OpenAI-Compatible Configuration
# When running receipt-scanner inside Docker and 9router on your host machine, use:
# ROUTER_BASE_URL=http://host.docker.internal:20128/v1
# When running locally without Docker:
ROUTER_BASE_URL=http://localhost:20128/v1
ROUTER_API_KEY=
ROUTER_MODEL=gemini-2.5-flash

# Google AI API Configuration (required only if LLM_PROVIDER=gemini)
GOOGLE_AI_API_KEY=your-google-ai-api-key
GEMINI_MODEL=gemini-2.5-flash
# Optional custom Gemini endpoint:
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Account Card Mappings (Automatic Account Detection)
# Map the last 4 digits of your card(s) and "cash" to your Firefly III asset account names.
# You can map multiple cards to the same account!
#
# Examples:
# Comma-separated (or using / for multiple cards):
ACCOUNT_CARD_MAPPINGS=1111:Easybank Giro, 2222:Easybank Giro, 5678:BAWAG Credit Card, cash:Cash wallet
# Or group with slash:
# ACCOUNT_CARD_MAPPINGS=1111/2222:Easybank Giro, 5678:BAWAG Credit Card, cash:Cash wallet
# Or as JSON:
# ACCOUNT_CARD_MAPPINGS={"1111": "Easybank Giro", "2222": "Easybank Giro", "5678": "BAWAG Credit Card", "cash": "Cash wallet"}
# Or JSON list per account:
# ACCOUNT_CARD_MAPPINGS={"Easybank Giro": ["1111", "2222"], "BAWAG Credit Card": ["5678"], "Cash wallet": "cash"}
# (Alternatively, you can place an `account_cards.json` file in the project directory)

