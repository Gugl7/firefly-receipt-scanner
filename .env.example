# Firefly III API Configuration
FIREFLY_III_URL=https://your-firefly-iii-instance.com
FIREFLY_III_TOKEN=your-personal-access-token

# LLM Provider Configuration
# Set to "gemini" for Google AI, or "ollama" / "9router" for local or self-hosted LLMs.
# Set to "auto" to automatically pick the best provider based on provided credentials.
LLM_PROVIDER=auto

# Google AI API Configuration
GOOGLE_AI_API_KEY=your-google-ai-api-key
GEMINI_MODEL=gemini-2.5-flash
# Optional custom Gemini endpoint:
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Local Ollama / 9Router / OpenAI-Compatible Configuration
# Set OLLAMA_BASE_URL (or ROUTER_BASE_URL) to use a local or remote Ollama server.
# When running receipt-scanner inside Docker and Ollama on another LAN server:
# OLLAMA_BASE_URL=http://192.168.0.58:11434/v1
# When running receipt-scanner inside Docker and Ollama on the same host:
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# When running locally without Docker:
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
# Optional API Key (if using a router, OpenRouter, vLLM, or authenticated proxy):
# ROUTER_API_KEY=

# Automatic Provider Fallback (Enabled by default)
# When LLM_FALLBACK_ENABLED=true and both Gemini and Ollama are configured:
# If Google Gemini experiences high demand (503), rate limits (429), or outages,
# the scanner will AUTOMATICALLY fall back to your local Ollama server without dropping requests!
LLM_FALLBACK_ENABLED=true

# Request timeout in seconds for LLM inference (default: 180s = 3 minutes).
# Increase this if running larger models on CPU or for cold starts (e.g. LLM_TIMEOUT=300).
LLM_TIMEOUT=180

# Local OCR Configuration
# Set OCR_ENABLED=true to run local Tesseract OCR on images/PDFs before sending text to the LLM.
# This cuts token consumption by ~70% and enables using text-only models (e.g. Nemotron, DeepSeek).
OCR_ENABLED=false
OCR_ENGINE=tesseract
OCR_LANGUAGE=eng+deu

# Account Card Mappings (Automatic Account Detection)
# Map the last 4 digits of your card(s) and "cash" to your Firefly III asset account names.
# You can map multiple cards to the same account!
#
# Examples:
# Comma-separated (or using / for multiple cards):
ACCOUNT_CARD_MAPPINGS=1111:Easybank Giro, 2222:Easybank Giro, 5678:BAWAG Credit Card, cash:Cash wallet
# Or group with slash:
# ACCOUNT_CARD_MAPPINGS=1111/2222:Easybank Giro, 5678:BAWAG Credit Card, cash:Cash wallet
# Or as JSON:
# ACCOUNT_CARD_MAPPINGS={"1111": "Easybank Giro", "2222": "Easybank Giro", "5678": "BAWAG Credit Card", "cash": "Cash wallet"}
# Or JSON list per account:
# ACCOUNT_CARD_MAPPINGS={"Easybank Giro": ["1111", "2222"], "BAWAG Credit Card": ["5678"], "Cash wallet": "cash"}
# (Alternatively, you can place an `account_cards.json` file in the project directory)

